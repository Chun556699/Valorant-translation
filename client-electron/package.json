{
  "name": "vtranslate",
  "version": "1.0.0",
  "description": "Valorant voice translation companion (Electron)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "//build": "requireAdministrator 必需：Valorant 由 Vanguard 以管理员权限拉起，非提权进程在游戏窗口聚焦时收不到全局热键（UIPI 隔离）",
  "build": {
    "appId": "com.chunfff.vtranslate",
    "productName": "VTranslate",
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "portable": {
      "artifactName": "VTranslate.exe"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "!src/renderer/rt.js",
      "!src/renderer/terms.js",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "uiohook-napi@1.5.5": true
  }
}
