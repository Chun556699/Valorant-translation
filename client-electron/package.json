{
  "name": "vtranslate",
  "version": "0.9.0",
  "description": "Valorant voice translation companion (Electron)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:nsis": "electron-builder --win nsis"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "_comment_win": "不内嵌 requireAdministrator：整进程提权有安全风险。Valorant 提权运行时热键可能失效，用户可手动右键以管理员身份运行",
    "appId": "com.chunfff.vtranslate",
    "productName": "VTranslate",
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "VTranslate.exe"
    },
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "uiohook-napi@1.5.5": true
  }
}
