# ===== 必填 =====
# 阿里云百炼 DashScope API Key（翻译费用走这里）
DASHSCOPE_API_KEY=sk-xxxxxxxx

# Z-Pay 商户信息（https://z-pay.cn 商户后台获取）
ZPAY_PID=你的商户号
ZPAY_KEY=你的商户密钥
# 公网可达的回调地址，z-pay 支付成功后 POST/GET 到它
ZPAY_NOTIFY_URL=https://你的域名/api/pay/notify

# ===== 可选 =====
# ZPAY_BASE_URL=https://z-pay.cn
# ZPAY_RETURN_URL=https://你的域名/pay/done
# DASHSCOPE_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime   # 默认值即通用端点，业务空间专属域名才需覆盖
# TRANSLATE_MODEL=qwen3.8-livetranslate-flash-realtime
# HOST=0.0.0.0
# PORT=8765
# DB_PATH=billing.db
# ADMIN_TOKEN=随便一个长字符串（管理接口 /api/admin/grant 用）
# TRIAL_SECONDS=300            # 新账号免费额度（秒）
# TRIAL_DAYS=7                 # 免费额度有效期（天）
# PRICE_FEN_PER_MINUTE=30      # 余额按量计费单价（分/分钟）
# REF_BONUS_PERCENT=10         # 推广返利比例（实付金额%返到邀请人余额）
# ANNOUNCEMENT=                # 客户端顶部公告栏文本
# MOCK_UPSTREAM=1              # 无 Key 调试用：伪造翻译结果回显
# TRUST_PROXY=0                # 部署在 Nginx/CF 后时设 1：限流按 X-Forwarded-For 首跳识别客户端。
                             # 警告：开启后必须同时用 uvicorn --proxy-headers 启动，
                             # 且确保反代会覆盖该头，否则客户端可伪造 IP 绕过限流
# DASH_SESSION_EXTRA_JSON={}   # 合并进 session.update 的额外字段

# ===== 运行须知 =====
# 本服务仅支持单进程运行（SQLite 单连接 + 进程内锁/限流状态都在进程内存里），
# 切勿用多个 uvicorn worker 或多实例指向同一个 DB 文件，会数据错乱。

